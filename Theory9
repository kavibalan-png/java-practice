        // removeAll()
        HashSet<String> removeSet = new HashSet<>(set1);
        removeSet.removeAll(set2);
        System.out.println("After removeAll(): " + removeSet);

        // retainAll()
        HashSet<String> retainSet = new HashSet<>(set1);
        retainSet.retainAll(set2);
        System.out.println("After retainAll(): " + retainSet);

        // containsAll()
        System.out.println("containsAll(): " + set1.containsAll(retainSet));

        // toArray()
        Object[] arr = set1.toArray();

        System.out.println("Array Elements:");
        for (Object obj : arr) {
            System.out.println(obj);
        }
    }
}
