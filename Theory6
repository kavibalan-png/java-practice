3. Read a File

Syntax
Scanner sc = new Scanner(file);

while(sc.hasNextLine()){

    System.out.println(sc.nextLine());

}
Program
import java.io.File;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        try {

            File file = new File("student.txt");

            Scanner sc = new Scanner(file);

            while (sc.hasNextLine()) {

                System.out.println(sc.nextLine());

            }

            sc.close();

        } catch (Exception e) {

            System.out.println("File Not Found.");

        }

    }

}
