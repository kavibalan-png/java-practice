problem
public class MaxHeap {

    private int[] heap;
    private int size;
    private int capacity;


    // Constructor
    public MaxHeap(int capacity) {

        this.capacity = capacity;
        heap = new int[capacity];
        size = 0;
    }


    // 1. INSERT OPERATION
    public void insert(int value) {

        if(size == capacity) {
            System.out.println("Heap is Full");
            return;
        }


        // Step 1: Add element at last position
        heap[size] = value;

        int index = size;

        size++;


        // Step 2: Heapify Up
        while(index > 0) {

            int parent = (index - 1) / 2;


            // Parent is smaller than child
            if(heap[parent] < heap[index]) {

                // Swap
                int temp = heap[parent];
                heap[parent] = heap[index];
                heap[index] = temp;


                index = parent;

            }
            else {
                break;
            }
        }
    }



    // 2. DELETE ROOT OPERATION
    public int delete() {

        if(size == 0) {
            return -1;
        }


        // Store maximum value
        int max = heap[0];


        // Move last element to root
        heap[0] = heap[size - 1];


        size--;


        // Heapify Down
        heapifyDown(0);


        return max;
    }



    // Heapify Down
    private void heapifyDown(int index) {


        while(index < size) {


            int largest = index;


            int left = 2 * index + 1;

            int right = 2 * index + 2;



            // Check left child
            if(left < size && heap[left] > heap[largest]) {

                largest = left;
            }


            // Check right child
            if(right < size && heap[right] > heap[largest]) {

                largest = right;
            }



            // No change needed
            if(largest == index) {
                break;
            }


            // Swap
            int temp = heap[index];
            heap[index] = heap[largest];
            heap[largest] = temp;


            index = largest;

        }

    }



    // 3. GET MAXIMUM
    public int peek() {

        if(size == 0) {
            return -1;
        }

        return heap[0];
    }



    // Display Heap
    public void display() {

        for(int i=0; i<size; i++) {

            System.out.print(heap[i] + " ");
        }

        System.out.println();
    }



    public static void main(String[] args) {


        MaxHeap heap = new MaxHeap(10);



        // Insert
        heap.insert(50);
        heap.insert(30);
        heap.insert(70);
        heap.insert(10);
        heap.insert(90);


        System.out.println("After Insert:");
        heap.display();



        // Get Maximum
        System.out.println("Maximum value: " + heap.peek());



        // Delete Root
        System.out.println("Deleted: " + heap.delete());


        System.out.println("After Delete:");
        heap.display();

    }
}




import java.util.PriorityQueue;

public class KthLargest {

    public static int findKthLargest(int[] nums, int k) {

        // Min Heap
        PriorityQueue<Integer> heap = new PriorityQueue<>();

        for (int num : nums) {

            heap.offer(num);

            if (heap.size() > k) {
                heap.poll();
            }
        }

        return heap.peek();
    }

    public static void main(String[] args) {

        int[] nums = {3,2,1,5,6,4};

        int k = 2;

        System.out.println(findKthLargest(nums, k));
    }
}


